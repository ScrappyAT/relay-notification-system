DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
DB_POOL_MAX=15
REDIS_URL=redis://localhost:6379
PORT=3000
# Outside dashboard/demo mode, unset hosts preserve the original Node binding defaults.
# API_HOST=0.0.0.0
# METRICS_HOST=127.0.0.1
# Demo mode always forces API and metrics listeners to 127.0.0.1.
DEMO_MODE=false
# Opt-in local admin read API; never expose this unauthenticated demo publicly.
DASHBOARD_ENABLED=false

# Observability (Optional daemon metrics ports)
# DISPATCHER_METRICS_PORT=3001
# WORKERS_METRICS_PORT=3002
# RECONCILIATION_METRICS_PORT=3003

# Tenant Rate Limiting (Milestone 6B)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIMEOUT_MS=500

# Tenant Fairness (Milestone 6C)
FAIRNESS_ENABLED=true
TENANT_MAX_CONCURRENT_JOBS=2
WORKER_CONCURRENCY=5
DISPATCHER_BATCH_SIZE=10

# Backpressure & Overload Protection (Milestone 6D)
BACKPRESSURE_ENABLED=true
BACKPRESSURE_OUTBOX_DEGRADED_THRESHOLD=500
BACKPRESSURE_OUTBOX_OVERLOAD_THRESHOLD=2000
BACKPRESSURE_QUEUE_DEGRADED_THRESHOLD=250
BACKPRESSURE_QUEUE_OVERLOAD_THRESHOLD=1000
BACKPRESSURE_CACHE_TTL_MS=1000
BACKPRESSURE_RETRY_AFTER_SECONDS=5
BACKPRESSURE_DB_POOL_MAX_RATIO=0.9
DISPATCHER_MAX_QUEUE_BACKLOG=500
